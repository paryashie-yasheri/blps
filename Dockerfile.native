# syntax=docker/dockerfile:1.6.0
#
# Multi-stage build for BLPS Spring Boot (GraalVM native).
#
# Build:
#   docker build -f Dockerfile.native --target runtime -t blps-spring-native .
#
# Build time: ~15-30 min first run, ~5 min cached rebuilds
# RAM needed: ~4 GB
# Disk needed: ~5 GB

# Use Ubuntu + download GraalVM CE (Alpine musl → glibc binary incompatibility)
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

# Install JDK and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        curl \
        tar \
        xz-utils \
        build-essential \
        zlib1g-dev \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy pre-built JAR from host
COPY build/libs/demo-*.jar /build/app.jar
RUN ls -lh /build/app.jar


# ── Stage 2: GraalVM native image ─────────────────────────────────────────────
FROM ubuntu:24.04 AS native

ENV DEBIAN_FRONTEND=noninteractive
ENV GRAALVM_HOME=/opt/graalvm-ce
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$GRAALVM_HOME/bin:$JAVA_HOME/bin:$PATH

# Install JDK and build tools + download GraalVM CE
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        curl \
        tar \
        xz-utils \
        build-essential \
        zlib1g-dev \
        ca-certificates \
        python3 \
        unzip \
    && rm -rf /var/lib/apt/lists/* && \
    curl -sL "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-21.0.2/graalvm-community-jdk-21.0.2_linux-x64_bin.tar.gz" \
        -o /tmp/graalvm.tar.gz && \
    mkdir -p /opt && tar xzf /tmp/graalvm.tar.gz -C /opt && rm /tmp/graalvm.tar.gz && \
    DIR=$(ls /opt | grep graalvm) && mv /opt/$DIR $GRAALVM_HOME && \
    echo "GraalVM ready: $($GRAALVM_HOME/bin/java --version | head -1)" && \
    $GRAALVM_HOME/bin/gu install native-image && \
    $GRAALVM_HOME/bin/gu install native-image-install-update-user && \
    mkdir -p $JAVA_HOME/conf/graalvm && \
    curl -sL "https://repo1.maven.org/maven2/org/springframework/experimental/spring-graalvm-native/0.10.6/spring-graalvm-native-0.10.6-reachability-metadata.zip" \
        -o /tmp/spring-native.zip && \
    unzip -q -o /tmp/spring-native.zip -d /tmp/spring-native && \
    cp -r /tmp/spring-native/REACHABILITY_META/* $JAVA_HOME/conf/graalvm/ || true && \
    rm -rf /tmp/spring-native* && \
    ls $GRAALVM_HOME/bin/native-image

WORKDIR /build

# Extract layered JAR for native-image
COPY --from=builder /build/app.jar .
RUN mkdir -p /app/layers && \
    java -Djarmode=layertools -jar app.jar extract --destination /app/layers && \
    ls /app/layers/

# Build native image
RUN $GRAALVM_HOME/bin/native-image \
    --initialize-at-build-time=org.slf4j,ch.qos.logback,org.apache.commons.logging \
    --initialize-at-build-time=org.apache.commons.text,org.apache.commons.lang3 \
    --initialize-at-build-time=com.fasterxml.jackson,com.ctc.wftt,org.yaml.snakeyaml \
    --initialize-at-build-time=sun.security.ssl,java.util.jar,java.util.zip \
    --initialize-at-build-time=org.springframework,org.aopalliance,org.springframework.security \
    --initialize-at-build-time=org.springframework.web,org.springframework.beans,org.springframework.core \
    --initialize-at-build-time=soaringLizards \
    --initialize-at-build-time=org.postgresql,com.atomikos \
    --initialize-at-build-time=net.minidev,net.sf.jopt \
    --initialize-at-build-time=org.quartz,org.quartz.utils \
    -H:Name=spring-app \
    -H:+AddAllCharsets \
    -H:+ReportExceptionStackTraces \
    -H:EnableURLProtocols=http,https \
    -H:+InstallSafepointGuards \
    --no-fallback \
    && ls -lh spring-app


# ── Stage 3: Minimal runtime ─────────────────────────────────────────────────
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=native /build/spring-app .

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=30s \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["/app/spring-app"]