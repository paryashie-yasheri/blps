# Server
SPRING_PORT=8080
SPRING_HOST=http://localhost:8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=studs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public
POSTGRES_XA_RESOURCE_NAME=main-postgres-xa
POSTGRES_XA_MIN_POOL_SIZE=1
POSTGRES_XA_MAX_POOL_SIZE=8
POSTGRES_XA_BORROW_TIMEOUT_SECONDS=5
POSTGRES_XA_MAINTENANCE_INTERVAL_SECONDS=60
POSTGRES_XA_MAX_IDLE_TIME_SECONDS=60
POSTGRES_XA_TEST_QUERY=SELECT 1
POSTGRES_STARTUP_CHECK_ENABLED=true
POSTGRES_REQUIRED_ON_STARTUP=true
POSTGRES_STARTUP_CHECK_TIMEOUT_SECONDS=3
POSTGRES_MAX_PREPARED_TRANSACTIONS=100

# Rewards PostgreSQL
REWARDS_POSTGRES_HOST=localhost
REWARDS_POSTGRES_PORT=5434
REWARDS_POSTGRES_DB=studs_rewards
REWARDS_POSTGRES_USER=postgres
REWARDS_POSTGRES_PASSWORD=postgres
REWARDS_POSTGRES_SCHEMA=public
REWARDS_POSTGRES_XA_RESOURCE_NAME=rewards-postgres-xa
REWARDS_POSTGRES_XA_MIN_POOL_SIZE=1
REWARDS_POSTGRES_XA_MAX_POOL_SIZE=8
REWARDS_POSTGRES_XA_BORROW_TIMEOUT_SECONDS=5
REWARDS_POSTGRES_XA_MAINTENANCE_INTERVAL_SECONDS=60
REWARDS_POSTGRES_XA_MAX_IDLE_TIME_SECONDS=60
REWARDS_POSTGRES_XA_TEST_QUERY=SELECT 1
REWARDS_POSTGRES_STARTUP_CHECK_ENABLED=true
REWARDS_POSTGRES_REQUIRED_ON_STARTUP=false
REWARDS_POSTGRES_STARTUP_CHECK_TIMEOUT_SECONDS=3
REWARDS_LIQUIBASE_ENABLED=true
REWARDS_POSTGRES_MAX_PREPARED_TRANSACTIONS=100

# Journal PostgreSQL
JOURNAL_POSTGRES_HOST=localhost
JOURNAL_POSTGRES_PORT=5433
JOURNAL_POSTGRES_DB=studs_journal
JOURNAL_POSTGRES_USER=postgres
JOURNAL_POSTGRES_PASSWORD=postgres
JOURNAL_POSTGRES_SCHEMA=public
JOURNAL_POSTGRES_XA_RESOURCE_NAME=journal-postgres-xa
JOURNAL_POSTGRES_XA_MIN_POOL_SIZE=1
JOURNAL_POSTGRES_XA_MAX_POOL_SIZE=8
JOURNAL_POSTGRES_XA_BORROW_TIMEOUT_SECONDS=5
JOURNAL_POSTGRES_XA_MAINTENANCE_INTERVAL_SECONDS=60
JOURNAL_POSTGRES_XA_MAX_IDLE_TIME_SECONDS=60
JOURNAL_POSTGRES_XA_TEST_QUERY=SELECT 1
JOURNAL_POSTGRES_STARTUP_CHECK_ENABLED=true
JOURNAL_POSTGRES_REQUIRED_ON_STARTUP=false
JOURNAL_POSTGRES_STARTUP_CHECK_TIMEOUT_SECONDS=3
JOURNAL_LIQUIBASE_ENABLED=true
JOURNAL_POSTGRES_MAX_PREPARED_TRANSACTIONS=100

# Spring / jOOQ
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JOOQ_SQL_DIALECT=POSTGRES

# LMS / edX
LMS_URL=http://localhost
LMS_CLIENT_ID=client-id
LMS_CLIENT_SECRET=client-secret
EDX_API_ADMIN_USERNAME=admin
EDX_API_ADMIN_PASSWORD=secure-admin-password
EDX_API_TEST_USERNAME=test_user
EDX_API_TEST_PASSWORD=test_password

# Atomikos
ATOMIKOS_LOG_BASE_DIR=./build/atomikos
ATOMIKOS_TM_UNIQUE_NAME=blps-tm
ATOMIKOS_TRANSACTION_TIMEOUT_SECONDS=30
ATOMIKOS_MAX_TIMEOUT_SECONDS=60
ATOMIKOS_CHECKPOINT_INTERVAL=500
ATOMIKOS_THREADED_2PC=true
ATOMIKOS_ENABLE_LOGGING=true
ATOMIKOS_FORCE_SHUTDOWN=false

# S3
S3_REGION=ru-central-1
S3_ENDPOINT=http://localhost:9000
S3_TENANT_ID=local-tenant
S3_SERVICE_NAME=s3
S3_BUCKET=blps-local
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_EMAIL=admin@admin.com
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_MASTER_REALM=blps-master

KEYCLOAK_MASTER_CLIENT_ID=blps-client
KEYCLOAK_MASTER_CLIENT_SECRET=blps-client-secret

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://pg:${POSTGRES_PORT}/${POSTGRES_DB}
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak_password
KC_DB_SCHEMA=keycloak
