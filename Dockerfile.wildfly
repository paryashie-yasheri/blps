FROM gradle:9.2.1-jdk21-alpine AS builder
WORKDIR /usr/src/

COPY settings.gradle.kts ./
COPY build.gradle.kts ./build.gradle.kts

COPY src ./src

RUN gradle bootWar --no-daemon

FROM quay.io/wildfly/wildfly:33.0.1.Final-jdk21

COPY --from=builder /usr/src/build/libs/blps.war /opt/jboss/wildfly/standalone/deployments/

RUN /opt/jboss/wildfly/bin/add-user.sh admin admin --silent

EXPOSE 8080 9990

CMD ["/opt/jboss/wildfly/bin/standalone.sh", "-b", "0.0.0.0", "-bmanagement", "0.0.0.0"]
