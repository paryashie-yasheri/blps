# syntax=docker/dockerfile:1.6.0
#
# Multi-stage build for datalake-sync (GraalVM native).
#
# Build:
#   docker build -f datalake-sync/Dockerfile.graalvm --target runtime \
#     -t blps-datalake-sync-native:latest ./datalake-sync
#
# Build time: ~5-15 min (cached after first run)
# RAM needed: ~4 GB

# Use Ubuntu + GraalVM CE (Alpine musl → glibc binary incompatibility)
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /build
COPY . .
RUN gradle bootJar -x test --no-daemon -Pspring.profiles.active=prod 2>&1 | tail -10 && \
    JAR=$(ls build/libs/demo-*.jar | head -1) && \
    cp "$JAR" app.jar && ls -lh app.jar


# ── Stage 2: GraalVM native image ────────────────────────────────────────────
FROM ubuntu:24.04 AS native

ENV DEBIAN_FRONTEND=noninteractive
ENV GRAALVM_HOME=/opt/graalvm-ce
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$GRAALVM_HOME/bin:$JAVA_HOME/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        curl \
        tar \
        xz-utils \
        build-essential \
        zlib1g-dev \
        ca-certificates \
        python3 \
        unzip \
    && rm -rf /var/lib/apt/lists/* && \
    curl -sL "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-21.0.2/graalvm-community-jdk-21.0.2_linux-x64_bin.tar.gz" \
        -o /tmp/graalvm.tar.gz && \
    mkdir -p /opt && tar xzf /tmp/graalvm.tar.gz -C /opt && rm /tmp/graalvm.tar.gz && \
    DIR=$(ls /opt | grep graalvm) && mv /opt/$DIR $GRAALVM_HOME && \
    $GRAALVM_HOME/bin/gu install native-image && \
    $GRAALVM_HOME/bin/gu install native-image-install-update-user && \
    mkdir -p $JAVA_HOME/conf/graalvm && \
    curl -sL "https://repo1.maven.org/maven2/org/springframework/experimental/spring-graalvm-native/0.10.6/spring-graalvm-native-0.10.6-reachability-metadata.zip" \
        -o /tmp/spring-native.zip && \
    unzip -q -o /tmp/spring-native.zip -d /tmp/spring-native && \
    cp -r /tmp/spring-native/REACHABILITY_META/* $JAVA_HOME/conf/graalvm/ || true && \
    rm -rf /tmp/spring-native* && \
    echo "GraalVM ready" && ls $GRAALVM_HOME/bin/native-image

WORKDIR /build

COPY --from=builder /build/app.jar .
RUN mkdir -p /app/layers && \
    java -Djarmode=layertools -jar app.jar extract --destination /app/layers && \
    ls /app/layers/

RUN $GRAALVM_HOME/bin/native-image \
    --layered-jar-input-path=/app/layers \
    --initialize-at-build-time=org.slf4j,ch.qos.logback \
    --initialize-at-build-time=org.apache.commons,org.apache.commons.text \
    --initialize-at-build-time=com.fasterxml.jackson,org.yaml.snakeyaml \
    --initialize-at-build-time=sun.security.ssl \
    --initialize-at-build-time=org.springframework,org.quartz \
    --initialize-at-build-time=soaringlizards \
    --initialize-at-build-time=org.postgresql \
    --initialize-at-build-time=org.apache.http \
    -H:Name=datalake-sync \
    -H:+AddAllCharsets \
    -H:+ReportExceptionStackTraces \
    -H:EnableURLProtocols=http,https \
    --no-fallback \
    && ls -lh datalake-sync


# ── Stage 3: Minimal runtime ─────────────────────────────────────────────────
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=native /build/datalake-sync .

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=30s \
    CMD curl -f http://localhost:8090/actuator/health || exit 1

ENTRYPOINT ["/app/datalake-sync"]