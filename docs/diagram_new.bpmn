<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_blps" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">

  <bpmn:collaboration id="Collaboration_blps">
    <bpmn:participant id="Participant_student" name="Студент" processRef="Process_student" />
    <bpmn:participant id="Participant_system" name="BLPS Backend" processRef="Process_system" />
    <bpmn:participant id="Participant_openedx" name="OpenEdX LMS" processRef="Process_openedx" />
    <bpmn:participant id="Participant_moderator" name="Модератор" processRef="Process_moderator" />
    <bpmn:participant id="Participant_scheduled" name="Планировщик" processRef="Process_scheduled" />
    <bpmn:messageFlow id="MF_enroll_to_edx" sourceRef="Activity_enroll" targetRef="Activity_edx_enroll" />
    <bpmn:messageFlow id="MF_edx_enroll_done" sourceRef="Activity_edx_enroll" targetRef="Activity_enroll" />
    <bpmn:messageFlow id="MF_lesson_to_track" sourceRef="Activity_lesson" targetRef="Activity_edx_track" />
    <bpmn:messageFlow id="MF_track_to_subsection" sourceRef="Activity_track_completion" targetRef="Activity_edx_subsection" />
    <bpmn:messageFlow id="MF_track_to_progress" sourceRef="Activity_track_completion" targetRef="Activity_edx_progress" />
    <bpmn:messageFlow id="MF_progress_done" sourceRef="Activity_edx_progress" targetRef="Activity_fetch_progress" />
    <bpmn:messageFlow id="MF_courses_list" sourceRef="Activity_edx_list_courses" targetRef="Activity_view_courses" />
    <bpmn:messageFlow id="MF_view_courses_to_edx" sourceRef="Activity_view_courses" targetRef="Activity_edx_list_courses" />
    <bpmn:messageFlow id="MF_login_to_keycloak" sourceRef="Activity_login_edx" targetRef="Activity_keycloak_login" />
    <bpmn:messageFlow id="MF_keycloak_user_create" sourceRef="Activity_create_keycloak_user" targetRef="Activity_keycloak_create_user" />
    <bpmn:messageFlow id="MF_balance_create" sourceRef="Activity_create_balance" targetRef="Activity_balance_view" />
    <bpmn:messageFlow id="MF_enroll_to_backend" sourceRef="Activity_enroll" targetRef="Activity_achievement_check_all" />
    <bpmn:messageFlow id="MF_ach_done_to_student" sourceRef="Activity_balance_add" targetRef="Activity_add_balance" />
    <bpmn:messageFlow id="MF_progress_to_ach" sourceRef="Activity_fetch_progress" targetRef="Activity_achievement_check_all" />
    <bpmn:messageFlow id="MF_view_rewards" sourceRef="Activity_view_rewards" targetRef="Activity_rewards_list" />
    <bpmn:messageFlow id="MF_redeem_start" sourceRef="Activity_redeem" targetRef="Gateway_redeem_checks" />
    <bpmn:messageFlow id="MF_redeem_done" sourceRef="Activity_redeem_xa" targetRef="Activity_redeem" />
    <bpmn:messageFlow id="MF_pulsar" sourceRef="Activity_pulsar_publish" targetRef="Activity_promocode_redis" />
    <bpmn:messageFlow id="MF_mod_ach" sourceRef="Activity_mod_ach_create" targetRef="Activity_achievement_check_all" />
    <bpmn:messageFlow id="MF_mod_r" sourceRef="Activity_mod_r_create" targetRef="Activity_rewards_list" />
  </bpmn:collaboration>

  <!-- ===== POOL 1: СТУДЕНТ ===== -->
  <bpmn:process id="Process_student" name="Студент" isExecutable="true">
    <bpmn:startEvent id="StartEvent_login">
      <bpmn:outgoing>Flow_login_to_gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Activity_login_edx" name="Аутентификация в OpenEdX">
      <bpmn:incoming>Flow_login_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_edx_to_keycloak</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_create_keycloak_user" name="Создание пользователя в Keycloak (если новый)">
      <bpmn:incoming>Flow_edx_to_keycloak</bpmn:incoming>
      <bpmn:outgoing>Flow_keycloak_to_balance</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_create_balance" name="Создание баланса (1000 баллов)">
      <bpmn:incoming>Flow_keycloak_to_balance</bpmn:incoming>
      <bpmn:outgoing>Flow_balance_to_main</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_main_actions">
      <bpmn:incoming>Flow_balance_to_main</bpmn:incoming>
      <bpmn:outgoing>Flow_main_to_courses</bpmn:outgoing>
      <bpmn:outgoing>Flow_main_to_balance_view</bpmn:outgoing>
      <bpmn:outgoing>Flow_main_to_achievements_view</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Activity_view_courses" name="Просмотр курсов">
      <bpmn:incoming>Flow_main_to_courses</bpmn:incoming>
      <bpmn:outgoing>Flow_courses_to_gateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_view_balance" name="Просмотр баланса">
      <bpmn:incoming>Flow_main_to_balance_view</bpmn:incoming>
      <bpmn:outgoing>Flow_balance_view_to_gateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_view_achievements" name="Просмотр достижений">
      <bpmn:incoming>Flow_main_to_achievements_view</bpmn:incoming>
      <bpmn:outgoing>Flow_achievements_view_to_gateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_action_choice">
      <bpmn:incoming>Flow_courses_to_gateway</bpmn:incoming>
      <bpmn:incoming>Flow_balance_view_to_gateway</bpmn:incoming>
      <bpmn:incoming>Flow_achievements_view_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_gateway_to_enroll</bpmn:outgoing>
      <bpmn:outgoing>Flow_gateway_to_lesson</bpmn:outgoing>
      <bpmn:outgoing>Flow_gateway_to_rewards</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Activity_enroll" name="Запись на курс">
      <bpmn:incoming>Flow_gateway_to_enroll</bpmn:incoming>
      <bpmn:outgoing>Flow_enroll_to_achievement_check</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_lesson" name="Прохождение урока">
      <bpmn:incoming>Flow_gateway_to_lesson</bpmn:incoming>
      <bpmn:outgoing>Flow_lesson_to_completion</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_track_completion" name="Отслеживание completion в EdX">
      <bpmn:incoming>Flow_lesson_to_completion</bpmn:incoming>
      <bpmn:outgoing>Flow_completion_to_subsection</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_fetch_subsection" name="Проверка subsection completion">
      <bpmn:incoming>Flow_completion_to_subsection</bpmn:incoming>
      <bpmn:outgoing>Flow_subsection_to_progress</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_fetch_progress" name="Проверка course progress">
      <bpmn:incoming>Flow_subsection_to_progress</bpmn:incoming>
      <bpmn:outgoing>Flow_progress_to_achievements</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_check_achievements" name="Проверка достижений (4 event types)">
      <bpmn:incoming>Flow_enroll_to_achievement_check</bpmn:incoming>
      <bpmn:incoming>Flow_progress_to_achievements</bpmn:incoming>
      <bpmn:outgoing>Flow_achievements_check_to_balance_add</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_add_balance" name="Начисление баллов за достижения">
      <bpmn:incoming>Flow_achievements_check_to_balance_add</bpmn:incoming>
      <bpmn:outgoing>Flow_balance_add_to_back</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_back_to_action">
      <bpmn:incoming>Flow_balance_add_to_back</bpmn:incoming>
      <bpmn:outgoing>Flow_back_to_courses</bpmn:outgoing>
      <bpmn:outgoing>Flow_back_to_rewards</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Activity_view_rewards" name="Просмотр доступных наград">
      <bpmn:incoming>Flow_gateway_to_rewards</bpmn:incoming>
      <bpmn:incoming>Flow_back_to_rewards</bpmn:incoming>
      <bpmn:outgoing>Flow_view_rewards_to_redeem</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_redeem" name="Списание баллов и получение награды">
      <bpmn:incoming>Flow_view_rewards_to_redeem</bpmn:incoming>
      <bpmn:outgoing>Flow_redeem_to_end</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="Event_end_redeem">
      <bpmn:incoming>Flow_redeem_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Student sequence flows -->
    <bpmn:sequenceFlow id="Flow_login_to_gateway" sourceRef="StartEvent_login" targetRef="Activity_login_edx" />
    <bpmn:sequenceFlow id="Flow_edx_to_keycloak" sourceRef="Activity_login_edx" targetRef="Activity_create_keycloak_user" />
    <bpmn:sequenceFlow id="Flow_keycloak_to_balance" sourceRef="Activity_create_keycloak_user" targetRef="Activity_create_balance" />
    <bpmn:sequenceFlow id="Flow_balance_to_main" sourceRef="Activity_create_balance" targetRef="Gateway_main_actions" />
    <bpmn:sequenceFlow id="Flow_main_to_courses" sourceRef="Gateway_main_actions" targetRef="Activity_view_courses" />
    <bpmn:sequenceFlow id="Flow_main_to_balance_view" sourceRef="Gateway_main_actions" targetRef="Activity_view_balance" />
    <bpmn:sequenceFlow id="Flow_main_to_achievements_view" sourceRef="Gateway_main_actions" targetRef="Activity_view_achievements" />
    <bpmn:sequenceFlow id="Flow_courses_to_gateway" sourceRef="Activity_view_courses" targetRef="Gateway_action_choice" />
    <bpmn:sequenceFlow id="Flow_balance_view_to_gateway" sourceRef="Activity_view_balance" targetRef="Gateway_action_choice" />
    <bpmn:sequenceFlow id="Flow_achievements_view_to_gateway" sourceRef="Activity_view_achievements" targetRef="Gateway_action_choice" />
    <bpmn:sequenceFlow id="Flow_gateway_to_enroll" sourceRef="Gateway_action_choice" targetRef="Activity_enroll" />
    <bpmn:sequenceFlow id="Flow_gateway_to_lesson" sourceRef="Gateway_action_choice" targetRef="Activity_lesson" />
    <bpmn:sequenceFlow id="Flow_gateway_to_rewards" sourceRef="Gateway_action_choice" targetRef="Activity_view_rewards" />
    <bpmn:sequenceFlow id="Flow_enroll_to_achievement_check" sourceRef="Activity_enroll" targetRef="Activity_check_achievements" />
    <bpmn:sequenceFlow id="Flow_lesson_to_completion" sourceRef="Activity_lesson" targetRef="Activity_track_completion" />
    <bpmn:sequenceFlow id="Flow_completion_to_subsection" sourceRef="Activity_track_completion" targetRef="Activity_fetch_subsection" />
    <bpmn:sequenceFlow id="Flow_subsection_to_progress" sourceRef="Activity_fetch_subsection" targetRef="Activity_fetch_progress" />
    <bpmn:sequenceFlow id="Flow_progress_to_achievements" sourceRef="Activity_fetch_progress" targetRef="Activity_check_achievements" />
    <bpmn:sequenceFlow id="Flow_achievements_check_to_balance_add" sourceRef="Activity_check_achievements" targetRef="Activity_add_balance" />
    <bpmn:sequenceFlow id="Flow_balance_add_to_back" sourceRef="Activity_add_balance" targetRef="Gateway_back_to_action" />
    <bpmn:sequenceFlow id="Flow_back_to_courses" sourceRef="Gateway_back_to_action" targetRef="Activity_view_courses" />
    <bpmn:sequenceFlow id="Flow_back_to_rewards" sourceRef="Gateway_back_to_action" targetRef="Activity_view_rewards" />
    <bpmn:sequenceFlow id="Flow_view_rewards_to_redeem" sourceRef="Activity_view_rewards" targetRef="Activity_redeem" />
    <bpmn:sequenceFlow id="Flow_redeem_to_end" sourceRef="Activity_redeem" targetRef="Event_end_redeem" />
  </bpmn:process>

  <!-- ===== POOL 2: BLPS BACKEND ===== -->
  <bpmn:process id="Process_system" name="BLPS Backend" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_auth" name="Аутентификация (Keycloak)">
        <bpmn:flowNodeRef>Activity_keycloak_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_keycloak_create_user</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_achievements" name="Достижения">
        <bpmn:flowNodeRef>Activity_achievement_check_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_achievement_condition_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_achievement_exists</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_balance" name="Баланс">
        <bpmn:flowNodeRef>Activity_balance_view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_balance_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_balance_deduct_xa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rewards" name="Награды">
        <bpmn:flowNodeRef>Activity_rewards_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_redeem_xa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_redeem_checks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pulsar" name="Pulsar / Promocode">
        <bpmn:flowNodeRef>Activity_pulsar_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_promocode_redis</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_journal" name="Ledger Journal">
        <bpmn:flowNodeRef>Activity_journal_append</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_datalake" name="Datalake Sync">
        <bpmn:flowNodeRef>Activity_datalake_sync</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Аутентификация -->
    <bpmn:task id="Activity_keycloak_login" name="Выдача JWT токена">
      <bpmn:incoming>Flow_msg_edx_done</bpmn:incoming>
      <bpmn:outgoing>Flow_msg_keycloak_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_keycloak_create_user" name="Создание пользователя">
      <bpmn:incoming>Flow_msg_keycloak_create</bpmn:incoming>
      <bpmn:outgoing>Flow_msg_keycloak_created</bpmn:outgoing>
    </bpmn:task>

    <!-- Достижения -->
    <bpmn:task id="Activity_achievement_check_all" name="Загрузить активные типы достижений">
      <bpmn:incoming>Flow_msg_enroll_done</bpmn:incoming>
      <bpmn:incoming>Flow_msg_progress_done</bpmn:incoming>
      <bpmn:outgoing>Flow_ach_check_to_condition</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_achievement_condition_match" name="Проверить условия (eventType, coursePattern, blockPattern, minCompletion)">
      <bpmn:incoming>Flow_ach_check_to_condition</bpmn:incoming>
      <bpmn:outgoing>Flow_condition_to_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_achievement_exists">
      <bpmn:incoming>Flow_condition_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_gateway_award</bpmn:outgoing>
      <bpmn:outgoing>Flow_gateway_skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_award_achievement" name="Запись UserAchievement">
      <bpmn:incoming>Flow_gateway_award</bpmn:incoming>
      <bpmn:outgoing>Flow_award_to_balance_add</bpmn:outgoing>
    </bpmn:task>

    <!-- Баланс -->
    <bpmn:task id="Activity_balance_view" name="Чтение user_balances" />
    <bpmn:task id="Activity_balance_add" name="Начисление баллов (обновление balance + BalanceTransaction)">
      <bpmn:incoming>Flow_award_to_balance_add</bpmn:incoming>
      <bpmn:outgoing>Flow_balance_added</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_balance_deduct_xa" name="Списание баллов (XA)" />

    <!-- Награды -->
    <bpmn:task id="Activity_rewards_list" name="Чтение rewards" />
    <bpmn:task id="Gateway_redeem_checks" name="Проверка: баланс + isActive + quantity">
      <bpmn:incoming>Flow_msg_redeem_start</bpmn:incoming>
      <bpmn:outgoing>Flow_redeem_check_to_xa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_redeem_xa" name="XA Транзакция (3 БД: main + rewards + journal)">
      <bpmn:incoming>Flow_redeem_check_to_xa</bpmn:incoming>
      <bpmn:outgoing>Flow_xa_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Activity_redeem_xa_detail" name="Детали XA" triggeredByEvent="false">
      <bpmn:incoming>Flow_redeem_check_to_xa</bpmn:incoming>
      <bpmn:outgoing>Flow_xa_done</bpmn:outgoing>
      <bpmn:startEvent id="Event_xa_start" />
      <bpmn:task id="Activity_xa_balance" name="Main DB: списать balance + BalanceTransaction (REWARD_REDEEM)" />
      <bpmn:task id="Activity_xa_reward" name="Rewards DB: UserReward + decrement quantity" />
      <bpmn:task id="Activity_xa_journal" name="Journal DB: LedgerEvent (append-only)">
        <bpmn:outgoing>Flow_xa_journal_to_end</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_xa_end">
        <bpmn:incoming>Flow_xa_journal_to_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_xa_balance_to_reward" sourceRef="Activity_xa_balance" targetRef="Activity_xa_reward" />
      <bpmn:sequenceFlow id="Flow_xa_reward_to_journal" sourceRef="Activity_xa_reward" targetRef="Activity_xa_journal" />
      <bpmn:sequenceFlow id="Flow_xa_journal_to_end" sourceRef="Activity_xa_journal" targetRef="Event_xa_end" />
    </bpmn:subProcess>

    <!-- Pulsar -->
    <bpmn:task id="Activity_pulsar_publish" name="Publish RewardRedemptionEvent (afterCommit)">
      <bpmn:incoming>Flow_xa_to_pulsar</bpmn:incoming>
      <bpmn:outgoing>Flow_pulsar_to_redis</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_promocode_redis" name="Promocode-service: запись в Redis">
      <bpmn:incoming>Flow_pulsar_to_redis</bpmn:incoming>
    </bpmn:task>

    <!-- Journal -->
    <bpmn:task id="Activity_journal_append" name="LedgerEvent.append()" />

    <!-- Datalake Sync -->
    <bpmn:task id="Activity_datalake_sync" name="Sync Postgres Journal → Iceberg (Spark SQL)">
      <bpmn:incoming>Flow_timer_sync</bpmn:incoming>
    </bpmn:task>

    <!-- System flows -->
    <bpmn:sequenceFlow id="Flow_msg_edx_done" sourceRef="Activity_keycloak_login" targetRef="Activity_keycloak_create_user" />
    <bpmn:sequenceFlow id="Flow_msg_keycloak_done" sourceRef="Activity_keycloak_login" targetRef="Activity_balance_view" />
    <bpmn:sequenceFlow id="Flow_msg_keycloak_create" sourceRef="Activity_keycloak_create_user" targetRef="Activity_keycloak_login" />
    <bpmn:sequenceFlow id="Flow_msg_keycloak_created" sourceRef="Activity_keycloak_create_user" targetRef="Activity_balance_view" />
    <bpmn:sequenceFlow id="Flow_msg_enroll_done" sourceRef="Activity_achievement_check_all" targetRef="Activity_achievement_condition_match" />
    <bpmn:sequenceFlow id="Flow_msg_progress_done" sourceRef="Activity_achievement_check_all" targetRef="Activity_achievement_condition_match" />
    <bpmn:sequenceFlow id="Flow_ach_check_to_condition" sourceRef="Activity_achievement_check_all" targetRef="Activity_achievement_condition_match" />
    <bpmn:sequenceFlow id="Flow_condition_to_gateway" sourceRef="Activity_achievement_condition_match" targetRef="Gateway_achievement_exists" />
    <bpmn:sequenceFlow id="Flow_gateway_award" sourceRef="Gateway_achievement_exists" targetRef="Activity_award_achievement" />
    <bpmn:sequenceFlow id="Flow_gateway_skip" sourceRef="Gateway_achievement_exists" targetRef="Activity_balance_add" />
    <bpmn:sequenceFlow id="Flow_award_to_balance_add" sourceRef="Activity_award_achievement" targetRef="Activity_balance_add" />
    <bpmn:sequenceFlow id="Flow_balance_added" sourceRef="Activity_balance_add" targetRef="Activity_rewards_list" />
    <bpmn:sequenceFlow id="Flow_msg_redeem_start" sourceRef="Activity_rewards_list" targetRef="Gateway_redeem_checks" />
    <bpmn:sequenceFlow id="Flow_redeem_check_to_xa" sourceRef="Gateway_redeem_checks" targetRef="Activity_redeem_xa" />
    <bpmn:sequenceFlow id="Flow_xa_done" sourceRef="Activity_redeem_xa" targetRef="Activity_journal_append" />
    <bpmn:sequenceFlow id="Flow_xa_to_pulsar" sourceRef="Activity_redeem_xa" targetRef="Activity_pulsar_publish" />
    <bpmn:sequenceFlow id="Flow_pulsar_to_redis" sourceRef="Activity_pulsar_publish" targetRef="Activity_promocode_redis" />
    <bpmn:sequenceFlow id="Flow_timer_sync" sourceRef="Activity_datalake_sync" targetRef="Activity_datalake_sync" />
  </bpmn:process>

  <!-- ===== POOL 3: OPENEDX LMS ===== -->
  <bpmn:process id="Process_openedx" name="OpenEdX LMS" isExecutable="false">
    <bpmn:serviceTask id="Activity_edx_list_courses" name="GET /api/courses/v1/courses/" />
    <bpmn:serviceTask id="Activity_edx_course_details" name="GET /api/courses/v1/courses/{key}" />
    <bpmn:serviceTask id="Activity_edx_enroll" name="POST /api/enrollment/v1/enrollment" />
    <bpmn:serviceTask id="Activity_edx_track" name="POST /api/completion/v1/completion-batch" />
    <bpmn:serviceTask id="Activity_edx_progress" name="GET /api/course_home/v1/progress/{key}" />
    <bpmn:serviceTask id="Activity_edx_subsection" name="GET subsection-completion" />
  </bpmn:process>

  <!-- ===== POOL 4: МОДЕРАТОР ===== -->
  <bpmn:process id="Process_moderator" name="Модератор" isExecutable="true">
    <bpmn:startEvent id="Event_moderator_start" name="Вход на платформу (Keycloak STAFF/ADMIN)">
      <bpmn:outgoing>Flow_mod_start_to_gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:inclusiveGateway id="Gateway_mod_actions">
      <bpmn:incoming>Flow_mod_start_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_mod_to_achievements</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_to_rewards</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_to_s3</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:inclusiveGateway id="Gateway_mod_achievements" name="Управление достижениями">
      <bpmn:incoming>Flow_mod_to_achievements</bpmn:incoming>
      <bpmn:outgoing>Flow_mod_ach_create</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_ach_update</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_ach_delete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Activity_mod_ach_create" name="Создание + иконка в S3" />
    <bpmn:task id="Activity_mod_ach_update" name="Редактирование" />
    <bpmn:task id="Activity_mod_ach_delete" name="Удаление" />

    <bpmn:inclusiveGateway id="Gateway_mod_rewards" name="Управление наградами">
      <bpmn:incoming>Flow_mod_to_rewards</bpmn:incoming>
      <bpmn:outgoing>Flow_mod_r_create</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_r_update</bpmn:outgoing>
      <bpmn:outgoing>Flow_mod_r_delete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Activity_mod_r_create" name="Создание награды" />
    <bpmn:task id="Activity_mod_r_update" name="Редактирование" />
    <bpmn:task id="Activity_mod_r_delete" name="Удаление" />

    <bpmn:task id="Activity_mod_s3_upload" name="Загрузка файлов в S3">
      <bpmn:incoming>Flow_mod_to_s3</bpmn:incoming>
    </bpmn:task>

    <!-- Moderator flows -->
    <bpmn:sequenceFlow id="Flow_mod_start_to_gateway" sourceRef="Event_moderator_start" targetRef="Gateway_mod_actions" />
    <bpmn:sequenceFlow id="Flow_mod_to_achievements" sourceRef="Gateway_mod_actions" targetRef="Gateway_mod_achievements" />
    <bpmn:sequenceFlow id="Flow_mod_to_rewards" sourceRef="Gateway_mod_actions" targetRef="Gateway_mod_rewards" />
    <bpmn:sequenceFlow id="Flow_mod_to_s3" sourceRef="Gateway_mod_actions" targetRef="Activity_mod_s3_upload" />
    <bpmn:sequenceFlow id="Flow_mod_ach_create" sourceRef="Gateway_mod_achievements" targetRef="Activity_mod_ach_create" />
    <bpmn:sequenceFlow id="Flow_mod_ach_update" sourceRef="Gateway_mod_achievements" targetRef="Activity_mod_ach_update" />
    <bpmn:sequenceFlow id="Flow_mod_ach_delete" sourceRef="Gateway_mod_achievements" targetRef="Activity_mod_ach_delete" />
    <bpmn:sequenceFlow id="Flow_mod_r_create" sourceRef="Gateway_mod_rewards" targetRef="Activity_mod_r_create" />
    <bpmn:sequenceFlow id="Flow_mod_r_update" sourceRef="Gateway_mod_rewards" targetRef="Activity_mod_r_update" />
    <bpmn:sequenceFlow id="Flow_mod_r_delete" sourceRef="Gateway_mod_rewards" targetRef="Activity_mod_r_delete" />
  </bpmn:process>

  <!-- ===== POOL 5: ПЛАНИРОВЩИК ===== -->
  <bpmn:process id="Process_scheduled" name="Планировщик" isExecutable="true">
    <bpmn:startEvent id="TimerEvent_datalake_sync">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>0 0 3 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_timer_to_sync_start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Activity_sync_read_iceberg" name="Чтение MAX(occurred_at) из Iceberg">
      <bpmn:incoming>Flow_timer_to_sync_start</bpmn:incoming>
      <bpmn:outgoing>Flow_read_iceberg_to_fetch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_sync_fetch_journal" name="Fetch новых событий из Postgres Journal">
      <bpmn:incoming>Flow_read_iceberg_to_fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_fetch_to_dedup</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_sync_dedup" name="Дедупликация по event_id">
      <bpmn:incoming>Flow_fetch_to_dedup</bpmn:incoming>
      <bpmn:outgoing>Flow_dedup_to_insert</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_sync_insert" name="Batch INSERT в Iceberg (Spark SQL)">
      <bpmn:incoming>Flow_dedup_to_insert</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_timer_to_sync_start" sourceRef="TimerEvent_datalake_sync" targetRef="Activity_sync_read_iceberg" />
    <bpmn:sequenceFlow id="Flow_read_iceberg_to_fetch" sourceRef="Activity_sync_read_iceberg" targetRef="Activity_sync_fetch_journal" />
    <bpmn:sequenceFlow id="Flow_fetch_to_dedup" sourceRef="Activity_sync_fetch_journal" targetRef="Activity_sync_dedup" />
    <bpmn:sequenceFlow id="Flow_dedup_to_insert" sourceRef="Activity_sync_dedup" targetRef="Activity_sync_insert" />
  </bpmn:process>

  <!-- ===== DIAGRAM (расположение элементов) ===== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_blps">

